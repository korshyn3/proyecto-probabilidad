<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<div class="page-header">
  <div class="page-header-inner">
    <div class="breadcrumb">Inicio / Distribuciones / t-Student</div>
    <h1>Distribución t de Student</h1>
    <p class="page-desc">Probabilidades y valores críticos de t(ν) — a más grados de libertad, más se parece a la normal</p>
  </div>
</div>

<div class="main-content">

  <div class="formula-row">
    <div class="formula-box">
      <div class="f-label">Función de densidad</div>
      <div class="f-expr" data-tex="f(t) = \frac{\Gamma\left(\frac{\nu+1}{2}\right)}{\sqrt{\nu\pi}\,\Gamma\left(\frac{\nu}{2}\right)} \left(1 + \frac{t^2}{\nu}\right)^{-\frac{\nu+1}{2}}">f(t) = Γ((ν+1)/2) / (√(νπ)·Γ(ν/2)) · (1+t²/ν)^(−(ν+1)/2)</div>
    </div>
    <div class="formula-box">
      <div class="f-label">Estadístico y grados de libertad</div>
      <div class="f-expr" data-tex="t = \frac{\bar{x} - \mu}{s / \sqrt{n}} \qquad \nu = n - 1">t = (x̄ − μ) / (s/√n),  ν = n − 1</div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <span class="card-title">Parámetros</span>
    </div>
    <div class="card-body">

      <div class="labeled-input">
        <label class="switch">
          <input type="checkbox" id="inverso" autocomplete="off" onchange="setInverso(this.checked)" />
          <span class="switch-track"></span>
          <span class="switch-text">Buscar <span class="sin-mayus">t</span> dado <span class="sin-mayus">p</span> (valor crítico)</span>
        </label>
      </div>

      <div class="labeled-input">
        <label class="input-label">Tipo de área</label>
        <div class="mode-group">
          <!-- data-dir: calcular p dado t · data-inv: buscar t dado p -->
          <button class="mode-btn active" data-mode="left"    data-icon="left"    data-dir="P(T ≤ t)"       data-inv="P(T ≤ t) = p"       onclick="setMode('left')">P(T ≤ t)</button>
          <button class="mode-btn"        data-mode="right"   data-icon="right"   data-dir="P(T ≥ t)"       data-inv="P(T ≥ t) = p"       onclick="setMode('right')">P(T ≥ t)</button>
          <button class="mode-btn"        data-mode="between" data-icon="between" data-dir="P(t₁ ≤ T ≤ t₂)" data-inv="P(−t ≤ T ≤ t) = p" onclick="setMode('between')">P(t₁ ≤ T ≤ t₂)</button>
          <button class="mode-btn"        data-mode="tails"   data-icon="tails"   data-dir="P(|T| ≥ t)"     data-inv="P(|T| ≥ t) = p"     onclick="setMode('tails')">P(|T| ≥ t)</button>
        </div>
      </div>

      <div class="input-row">
        <div class="input-col" id="colT1">
          <label class="input-label" id="labelT1">Valor de <span class="sin-mayus">t</span></label>
          <input type="number" id="t1" step="0.001" placeholder="Ej: 2.262" />
        </div>
        <div class="input-col" id="colT2" style="display:none;">
          <label class="input-label">Valor de <span class="sin-mayus">t₂</span></label>
          <input type="number" id="t2" step="0.001" placeholder="Ej: 3.0" />
        </div>
        <div class="input-col" id="colP" style="display:none;">
          <label class="input-label">Probabilidad <span class="sin-mayus">p</span></label>
          <input type="number" id="pInv" step="0.001" min="0.001" max="0.999" placeholder="Ej: 0.95" />
        </div>
        <div class="input-col" style="flex:0 0 auto;">
          <label class="input-label" style="white-space:nowrap;">Grados de libertad <span class="sin-mayus">ν = n − 1</span></label>
          <input type="number" id="gl" step="1" min="1" placeholder="Ej: n = 10 → ν = 9" />
        </div>
        <div style="display:flex; align-items:flex-end;">
          <button class="btn" id="btnCalc" onclick="calcular()">Calcular</button>
        </div>
      </div>
      <p class="field-hint" id="hint">Ejemplo: con ν = 9, t = 2.262 deja 2.5% en cada cola (el t crítico de un intervalo al 95%).</p>

    </div>
  </div>

  <div class="alert alert-error" id="errorBox"></div>

  <div id="results">
    <div class="card">
      <div class="card-header">
        <span class="card-title" id="chartTitle">Distribución t de Student</span>
      </div>
      <div class="card-body">
        <div class="legend-row">
          <div class="legend-item">
            <div class="legend-line" style="background:#1a3a6b;"></div>
            <span id="legendT">t(ν)</span>
          </div>
          <div class="legend-item">
            <div class="legend-line dashed"></div>
            <span>N(0,1)</span>
          </div>
          <div class="legend-item">
            <div style="width:24px; height:14px; background:rgba(26,58,107,0.18); border:1px solid rgba(26,58,107,0.4); border-radius:2px;"></div>
            <span>Área = probabilidad</span>
          </div>
        </div>
        <div class="chart-wrap">
          <canvas id="tChart"></canvas>
        </div>
        <p class="chart-note" id="chartNote"></p>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span class="card-title">Resultados</span>
      </div>
      <div class="card-body" id="statsGrid"></div>
    </div>
  </div>

</div>

<script>
// ── Math helpers ──────────────────────────────────────────────────────────────
function logGamma(z) {
  if (z < 0.5) return Math.log(Math.PI / Math.sin(Math.PI * z)) - logGamma(1 - z);
  z--;
  const g = 7;
  const c = [0.99999999999980993,676.5203681218851,-1259.1392167224028,
             771.32342877765313,-176.61502916214059,12.507343278686905,
             -0.13857109526572012,9.9843695780195716e-6,1.5056327351493116e-7];
  let x = c[0];
  for (let i = 1; i < g + 2; i++) x += c[i] / (z + i);
  const t = z + g + 0.5;
  return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
}

function betaCF(x, a, b) {
  const MAXIT = 300, EPS = 1e-12, FPMIN = 1e-300;
  const qab = a + b, qap = a + 1, qam = a - 1;
  let c = 1, d = 1 - qab * x / qap;
  if (Math.abs(d) < FPMIN) d = FPMIN;
  d = 1 / d;
  let h = d;
  for (let m = 1; m <= MAXIT; m++) {
    const m2 = 2 * m;
    let aa = m * (b - m) * x / ((qam + m2) * (a + m2));
    d = 1 + aa * d; if (Math.abs(d) < FPMIN) d = FPMIN;
    c = 1 + aa / c; if (Math.abs(c) < FPMIN) c = FPMIN;
    d = 1 / d; h *= d * c;
    aa = -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2));
    d = 1 + aa * d; if (Math.abs(d) < FPMIN) d = FPMIN;
    c = 1 + aa / c; if (Math.abs(c) < FPMIN) c = FPMIN;
    d = 1 / d;
    const del = d * c; h *= del;
    if (Math.abs(del - 1) < EPS) break;
  }
  return h;
}

function ibeta(x, a, b) {
  if (x <= 0) return 0;
  if (x >= 1) return 1;
  const lbeta = logGamma(a) + logGamma(b) - logGamma(a + b);
  const front = Math.exp(Math.log(x) * a + Math.log(1 - x) * b - lbeta);
  if (x < (a + 1) / (a + b + 2)) return front * betaCF(x, a, b) / a;
  return 1 - front * betaCF(1 - x, b, a) / b;
}

function tCDF(t, df) {
  const p = 0.5 * ibeta(df / (df + t * t), df / 2, 0.5);
  return t >= 0 ? 1 - p : p;
}

// t tal que P(T ≤ t) = p, por bisección
function tInv(p, df) {
  let lim = 1;
  while (tCDF(lim, df) < p || tCDF(-lim, df) > p) lim *= 2;
  let lo = -lim, hi = lim;
  for (let i = 0; i < 200 && hi - lo > 1e-10; i++) {
    const mid = (lo + hi) / 2;
    if (tCDF(mid, df) < p) lo = mid; else hi = mid;
  }
  return (lo + hi) / 2;
}

function tPDF(t, df) {
  const lnum = logGamma((df + 1) / 2);
  const lden = 0.5 * Math.log(df * Math.PI) + logGamma(df / 2);
  return Math.exp(lnum - lden) * Math.pow(1 + t * t / df, -(df + 1) / 2);
}

function normalPDF(z) { return Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI); }

function normalCDF(z) {
  const a1=0.254829592,a2=-0.284496736,a3=1.421413741,a4=-1.453152027,a5=1.061405429,p=0.3275911;
  const sign = z < 0 ? -1 : 1;
  const x = Math.abs(z) / Math.sqrt(2);
  const t = 1 / (1 + p * x);
  const y = 1 - (((((a5*t+a4)*t+a3)*t+a2)*t+a1)*t*Math.exp(-x*x));
  return 0.5 * (1 + sign * y);
}

function normalInv(p) {
  let lo = -40, hi = 40;
  for (let i = 0; i < 200 && hi - lo > 1e-10; i++) {
    const mid = (lo + hi) / 2;
    if (normalCDF(mid) < p) lo = mid; else hi = mid;
  }
  return (lo + hi) / 2;
}

function genCurva(f, desde, hasta, paso) {
  const pts = [];
  for (let x = desde; x <= hasta + paso / 2; x += paso) pts.push({ x: +x.toFixed(3), y: f(x) });
  return pts;
}

// ── State ─────────────────────────────────────────────────────────────────────
let currentMode = 'left';
let inverso = false;   // true = buscar t dado p
let myChart = null;

function setMode(mode) {
  currentMode = mode;
  actualizarControles();
}

function setInverso(valor) {
  inverso = valor;
  actualizarControles();
}

function actualizarControles() {
  const mode = currentMode;
  document.querySelectorAll('[data-mode]').forEach(b => {
    b.classList.toggle('active', b.dataset.mode === mode);
    b.querySelector('span').textContent = inverso ? b.dataset.inv : b.dataset.dir;
    // En modo inverso "entre t₁ y t₂" se vuelve el intervalo simétrico −t..t
    const icono = inverso && b.dataset.mode === 'between' ? 'center' : b.dataset.icon;
    const tmp = document.createElement('div');
    tmp.innerHTML = iconoCampana(icono);
    b.querySelector('svg').replaceWith(tmp.firstElementChild);
  });
  document.getElementById('colT1').style.display = inverso ? 'none' : '';
  document.getElementById('colT2').style.display = !inverso && mode === 'between' ? '' : 'none';
  document.getElementById('colP').style.display  = inverso ? '' : 'none';
  document.getElementById('labelT1').innerHTML =
    `Valor de <span class="sin-mayus">${mode === 'between' ? 't₁' : 't'}</span>` + (mode === 'tails' ? ' (positivo)' : '');
  document.getElementById('hint').textContent = inverso
    ? 'Ejemplo: ν = 9 y P(−t ≤ T ≤ t) = 0.95 da t = 2.262 (t crítico para un intervalo al 95%).'
    : 'Ejemplo: con ν = 9, t = 2.262 deja 2.5% en cada cola (el t crítico de un intervalo al 95%).';
  document.getElementById('errorBox').style.display = 'none';
  document.getElementById('results').style.display  = 'none';
}

ponerIconos();

// ── Chart ─────────────────────────────────────────────────────────────────────
function buildChart(df, zonas, lim) {
  const ctx = document.getElementById('tChart').getContext('2d');
  if (myChart) { myChart.destroy(); myChart = null; }
  const f = t => tPDF(t, df);

  const datasets = [
    { data: genCurva(f, -lim, lim, 0.05), borderColor: COLOR_ACENTO, borderWidth: 2.5, pointRadius: 0, fill: false, tension: 0.4, order: 0 },
    { data: genCurva(normalPDF, -lim, lim, 0.05), borderColor: '#aaaaaa', borderWidth: 1.5, borderDash: [5, 4], pointRadius: 0, fill: false, tension: 0.4, order: 0 },
    ...zonas.map(([a, b]) => ({
      data: genCurva(f, Math.max(a, -lim), Math.min(b, lim), 0.02),
      borderColor: 'rgba(26,58,107,0.45)', backgroundColor: 'rgba(26,58,107,0.18)',
      borderWidth: 1, pointRadius: 0, fill: 'origin', tension: 0.4, order: 1,
    })),
  ];

  myChart = new Chart(ctx, {
    type: 'scatter',
    data: { datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 350 },
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      scales: {
        x: { type: 'linear', min: -lim, max: lim, ticks: { font: FUENTE_GRAFICA, maxTicksLimit: 9 }, grid: { color: 'rgba(0,0,0,0.06)' } },
        y: { min: 0, max: 0.42, ticks: { font: FUENTE_GRAFICA }, grid: { color: 'rgba(0,0,0,0.06)' } },
      },
      showLine: true,
    },
  });
}

// ── Calculate ─────────────────────────────────────────────────────────────────
function calcular() {
  document.getElementById('errorBox').style.display = 'none';

  const df = Number(document.getElementById('gl').value);
  if (!Number.isInteger(df) || df < 1) { mostrarError('Ingresa un número entero de grados de libertad ≥ 1.'); return; }

  const cdf = t => tCDF(t, df);
  const f4  = n => fmt(n, 4);
  let zonas, nota, grupos, marcas;

  if (inverso) {
    const invType = currentMode === 'between' ? 'center' : currentMode;
    const p = parseFloat(document.getElementById('pInv').value);
    if (isNaN(p) || p <= 0 || p >= 1) { mostrarError('Ingresa una probabilidad entre 0 y 1 (sin incluir extremos).'); return; }
    let t, z, texto, verif;
    if (invType === 'left') {
      t = tInv(p, df); z = normalInv(p);
      zonas = [[-Infinity, t]]; texto = `P(T ≤ ${f4(t)}) = ${p}`; verif = cdf(t);
    } else if (invType === 'right') {
      t = tInv(1 - p, df); z = normalInv(1 - p);
      zonas = [[t, Infinity]]; texto = `P(T ≥ ${f4(t)}) = ${p}`; verif = 1 - cdf(t);
    } else if (invType === 'tails') {
      // p se reparte en las dos colas: p/2 en cada una
      t = tInv(1 - p / 2, df); z = normalInv(1 - p / 2);
      zonas = [[-Infinity, -t], [t, Infinity]]; texto = `P(|T| ≥ ${f4(t)}) = ${p}`; verif = 2 * (1 - cdf(t));
    } else {
      t = tInv((1 + p) / 2, df); z = normalInv((1 + p) / 2);
      zonas = [[-t, t]]; texto = `P(−${f4(t)} ≤ T ≤ ${f4(t)}) = ${p}`; verif = cdf(t) - cdf(-t);
    }
    const pm = invType === 'center' || invType === 'tails' ? '±' : '';
    nota = `Área sombreada: ${texto}`;
    marcas = [Math.abs(t)];
    grupos = [
      grupoRes('Parámetros', [celda('p', 'probabilidad dada', p), celda('ν', 'grados de libertad', df)]),
      grupoRes('Resultado', [celda(pm + 't', 'valor crítico', pm + f4(t), true), celda('P', 'verificación', fmt(verif))]),
      grupoRes('Comparación', [celda(pm + 'z', 'misma área en N(0,1)', pm + f4(z)), celda('t − z', 'diferencia', f4(Math.abs(t) - Math.abs(z)))], 'con la normal'),
    ];
  } else {
    const t1 = parseFloat(document.getElementById('t1').value);
    if (isNaN(t1)) { mostrarError('Ingresa un valor de t válido.'); return; }
    let t2;
    if (currentMode === 'between') {
      t2 = parseFloat(document.getElementById('t2').value);
      if (isNaN(t2)) { mostrarError('Ingresa un valor de t₂ válido.'); return; }
      if (t1 >= t2) { mostrarError('t₁ debe ser menor que t₂.'); return; }
    }
    if (currentMode === 'tails' && t1 <= 0) { mostrarError('Ingresa un valor t positivo para las dos colas.'); return; }

    let prob, probZ, simbolo, texto, entrada;
    if (currentMode === 'left') {
      prob = cdf(t1); probZ = normalCDF(t1); zonas = [[-Infinity, t1]];
      simbolo = 'P(T ≤ t)'; texto = `P(T ≤ ${t1})`; entrada = [celda('t', 'valor dado', t1)];
    } else if (currentMode === 'right') {
      prob = 1 - cdf(t1); probZ = 1 - normalCDF(t1); zonas = [[t1, Infinity]];
      simbolo = 'P(T ≥ t)'; texto = `P(T ≥ ${t1})`; entrada = [celda('t', 'valor dado', t1)];
    } else if (currentMode === 'between') {
      prob = cdf(t2) - cdf(t1); probZ = normalCDF(t2) - normalCDF(t1); zonas = [[t1, t2]];
      simbolo = 'P(t₁ ≤ T ≤ t₂)'; texto = `P(${t1} ≤ T ≤ ${t2})`; entrada = [celda('t₁ , t₂', 'intervalo', `${t1} , ${t2}`)];
    } else {
      prob = 2 * (1 - cdf(t1)); probZ = 2 * (1 - normalCDF(t1)); zonas = [[-Infinity, -t1], [t1, Infinity]];
      simbolo = 'P(|T| ≥ t)'; texto = `P(|T| ≥ ${t1})`; entrada = [celda('±t', 'valor dado', '±' + t1)];
    }
    nota = `Área sombreada: ${texto} = ${f4(prob)}  (ν = ${df})`;
    marcas = [Math.abs(t1), Math.abs(t2 || 0)];
    grupos = [
      grupoRes('Parámetros', [...entrada, celda('ν', 'grados de libertad', df)]),
      grupoRes('Resultado', [celda(simbolo, 'probabilidad', fmt(prob), true), celda('1 − P', 'complemento', fmt(1 - prob))]),
      grupoRes('Comparación', [celda(simbolo.replace(/T/g, 'Z'), 'misma área en N(0,1)', fmt(probZ)), celda('P<sub>t</sub> − P<sub>z</sub>', 'diferencia', fmt(prob - probZ))], 'con la normal'),
    ];
  }

  const lim = Math.min(Math.max(4, ...marcas.map(m => m * 1.3 + 0.5)), 12);
  document.getElementById('chartTitle').innerHTML = `<span class="sin-mayus">t(${df})</span> vs N(0, 1)`;
  document.getElementById('legendT').textContent = `t(${df})`;
  buildChart(df, zonas, lim);
  document.getElementById('chartNote').textContent = nota;
  document.getElementById('statsGrid').innerHTML = `<div class="res-split">${grupos.join('')}</div>`;
  document.getElementById('results').style.display = 'block';
}

enterCalcula(['gl', 't1', 't2', 'pInv'], calcular);
</script>
