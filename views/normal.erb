<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<div class="page-header">
  <div class="page-header-inner">
    <div class="breadcrumb">Inicio / Distribuciones / Normal</div>
    <h1>Distribución Normal Estándar</h1>
    <p class="page-desc">Visualización interactiva de N(0,1) — áreas y probabilidades bajo la curva</p>
  </div>
</div>

<div class="main-content">

  <div class="formula-row">
    <div class="formula-box">
      <div class="f-label">Función de densidad</div>
      <div class="f-expr" data-tex="f(z) = \frac{1}{\sqrt{2\pi}}\, e^{-z^2/2}">f(z) = (1/√(2π)) · e^(−z²/2)</div>
    </div>
    <div class="formula-box">
      <div class="f-label">Notación</div>
      <div class="f-expr" data-tex="Z \sim N(0, 1) \;\Rightarrow\; \mu = 0,\ \sigma = 1">Z ~ N(0, 1)  →  μ=0, σ=1</div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <span class="card-title">Parámetros</span>
    </div>
    <div class="card-body">

      <div class="labeled-input">
        <label class="switch">
          <input type="checkbox" id="inverso" autocomplete="off" onchange="setInverso(this.checked)" />
          <span class="switch-track"></span>
          <span class="switch-text">Buscar <span class="sin-mayus">k</span> dado <span class="sin-mayus">p</span> (valor crítico)</span>
        </label>
      </div>

      <div class="labeled-input">
        <label class="input-label">Tipo de área</label>
        <div class="mode-group">
          <!-- data-dir: calcular p dado k · data-inv: buscar k dado p -->
          <button class="mode-btn active" data-mode="left"    data-icon="left"    data-dir="P(Z ≤ k)"       data-inv="P(Z ≤ k) = p"       onclick="setMode('left')">P(Z ≤ k)</button>
          <button class="mode-btn"        data-mode="right"   data-icon="right"   data-dir="P(Z ≥ k)"       data-inv="P(Z ≥ k) = p"       onclick="setMode('right')">P(Z ≥ k)</button>
          <button class="mode-btn"        data-mode="between" data-icon="between" data-dir="P(k₁ ≤ Z ≤ k₂)" data-inv="P(−k ≤ Z ≤ k) = p" onclick="setMode('between')">P(k₁ ≤ Z ≤ k₂)</button>
          <button class="mode-btn"        data-mode="tails"   data-icon="tails"   data-dir="P(|Z| ≥ k)"     data-inv="P(|Z| ≥ k) = p"     onclick="setMode('tails')">P(|Z| ≥ k)</button>
        </div>
      </div>

      <div class="input-row" id="inputRow">
        <div class="input-col" id="colZ1">
          <label class="input-label" id="labelZ1">Valor de <span class="sin-mayus">k</span></label>
          <input type="text" id="z1" placeholder="Ej: 1.65" />
          <div class="inf-btns">
            <button class="inf-btn" id="inf-z1-neg" onclick="setInf('z1','neg')">−∞</button>
            <button class="inf-btn" id="inf-z1-pos" onclick="setInf('z1','pos')">+∞</button>
          </div>
        </div>
        <div class="input-col" id="colZ2" style="display:none;">
          <label class="input-label">Valor de <span class="sin-mayus">k₂</span></label>
          <input type="text" id="z2" placeholder="Ej: 2.33" />
          <div class="inf-btns">
            <button class="inf-btn" id="inf-z2-neg" onclick="setInf('z2','neg')">−∞</button>
            <button class="inf-btn" id="inf-z2-pos" onclick="setInf('z2','pos')">+∞</button>
          </div>
        </div>
        <div class="input-col" id="colP" style="display:none;">
          <label class="input-label">Probabilidad <span class="sin-mayus">p</span></label>
          <input type="number" id="pInv" step="0.001" min="0.001" max="0.999" placeholder="Ej: 0.95" />
        </div>
        <div style="display:flex; align-items:flex-end;">
          <button class="btn" id="btnCalc" onclick="calcular()">Calcular</button>
        </div>
      </div>
      <p class="field-hint" id="hintNormal">Los valores k típicos están entre −4 y 4.</p>

    </div>
  </div>

  <div class="alert alert-error" id="errorBox"></div>

  <div id="results">
    <div class="card">
      <div class="card-header">
        <span class="card-title">Distribución Normal Estándar N(0, 1)</span>
      </div>
      <div class="card-body">
        <div class="legend-row">
          <div class="legend-item">
            <div class="legend-line" style="background:#1a3a6b; height:2px;"></div>
            <span>Curva N(0,1)</span>
          </div>
          <div class="legend-item">
            <div style="width:24px; height:14px; background:rgba(26,58,107,0.18); border:1px solid rgba(26,58,107,0.4); border-radius:2px;"></div>
            <span>Área = probabilidad</span>
          </div>
        </div>
        <div class="chart-wrap">
          <canvas id="normalChart"></canvas>
        </div>
        <p class="chart-note" id="chartNote"></p>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span class="card-title">Resultados</span>
      </div>
      <div class="card-body" id="statsGrid"></div>
    </div>
  </div>

</div>

<script>
// ── Math helpers ──────────────────────────────────────────────────────────────
function normalPDF(z) {
  return Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI);
}

function normalCDF(z) {
  const a1=0.254829592, a2=-0.284496736, a3=1.421413741,
        a4=-1.453152027, a5=1.061405429, p=0.3275911;
  const sign = z < 0 ? -1 : 1;
  const x = Math.abs(z) / Math.sqrt(2);
  const t = 1 / (1 + p * x);
  const y = 1 - (((((a5*t + a4)*t + a3)*t + a2)*t + a1)*t * Math.exp(-x*x));
  return 0.5 * (1 + sign * y);
}

function normalQuantile(p) {
  if (p <= 0 || p >= 1) return NaN;
  const a = [-3.969683028665376e+01,  2.209460984245205e+02,
             -2.759285104469687e+02,  1.383577518672690e+02,
             -3.066479806614716e+01,  2.506628277459239e+00];
  const b = [-5.447609879822406e+01,  1.615858368580409e+02,
             -1.556989798598866e+02,  6.680131188771972e+01,
             -1.328068155288572e+01];
  const c = [-7.784894002430293e-03, -3.223964580411365e-01,
             -2.400758277161838e+00, -2.549732539343734e+00,
              4.374664141464968e+00,  2.938163982698783e+00];
  const d = [ 7.784695709041462e-03,  3.224671290700398e-01,
              2.445134137142996e+00,  3.754408661907416e+00];
  const pLow = 0.02425, pHigh = 1 - pLow;
  let q;
  if (p < pLow) {
    q = Math.sqrt(-2 * Math.log(p));
    return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /
            ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
  } else if (p <= pHigh) {
    q = p - 0.5;
    const r = q * q;
    return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q /
            (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1);
  } else {
    q = Math.sqrt(-2 * Math.log(1 - p));
    return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /
              ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
  }
}

function genCurve(from, to, step) {
  const pts = [];
  for (let z = from; z <= to + step/2; z += step) {
    pts.push({ x: +z.toFixed(3), y: normalPDF(z) });
  }
  return pts;
}

// ── Infinity helpers ──────────────────────────────────────────────────────────
function parseZ(val) {
  const s = String(val).trim();
  if (s === '∞' || s === '+∞') return Infinity;
  if (s === '−∞' || s === '-∞') return -Infinity;
  return parseFloat(s);
}

function chartClamp(z) {
  if (!isFinite(z)) return z > 0 ? 4 : -4;
  return Math.max(-4, Math.min(4, z));
}

function setInf(id, dir) {
  document.getElementById(id).value = dir === 'pos' ? '∞' : '−∞';
  document.querySelectorAll(`[id^="inf-${id}-"]`).forEach(b => b.classList.remove('active'));
  document.getElementById(`inf-${id}-${dir}`).classList.add('active');
}

// ── State ─────────────────────────────────────────────────────────────────────
let currentMode = 'left';
let inverso     = false;   // true = buscar k dado p
let myChart     = null;

function setMode(mode) {
  currentMode = mode;
  actualizarControles();
}

function setInverso(valor) {
  inverso = valor;
  actualizarControles();
}

function actualizarControles() {
  const mode = currentMode;
  document.querySelectorAll('[data-mode]').forEach(b => {
    b.classList.toggle('active', b.dataset.mode === mode);
    b.querySelector('span').textContent = inverso ? b.dataset.inv : b.dataset.dir;
    // En modo inverso "entre k₁ y k₂" se vuelve el intervalo simétrico −k..k
    const icono = inverso && b.dataset.mode === 'between' ? 'center' : b.dataset.icon;
    const tmp = document.createElement('div');
    tmp.innerHTML = iconoCampana(icono);
    b.querySelector('svg').replaceWith(tmp.firstElementChild);
  });
  document.getElementById('colZ1').style.display = inverso ? 'none' : '';
  document.getElementById('colZ2').style.display = !inverso && mode === 'between' ? '' : 'none';
  document.getElementById('colP').style.display  = inverso ? '' : 'none';
  document.getElementById('labelZ1').innerHTML =
    `Valor de <span class="sin-mayus">${mode === 'between' ? 'k₁' : 'k'}</span>` + (mode === 'tails' ? ' (positivo)' : '');
  document.getElementById('hintNormal').textContent = inverso
    ? 'Ejemplo: P(−k ≤ Z ≤ k) = 0.95 da k = 1.96 (valor crítico para un intervalo al 95%).'
    : 'Los valores k típicos están entre −4 y 4.';
  document.getElementById('errorBox').style.display = 'none';
  document.getElementById('results').style.display  = 'none';
  document.querySelectorAll('.inf-btn').forEach(b => b.classList.remove('active'));
}

ponerIconos();

// ── Chart ─────────────────────────────────────────────────────────────────────
function buildChart(shadedSets) {
  const ctx = document.getElementById('normalChart').getContext('2d');
  if (myChart) { myChart.destroy(); myChart = null; }

  const fullCurve = genCurve(-4, 4, 0.04);

  const datasets = [
    {
      data: fullCurve,
      borderColor: '#1a3a6b',
      borderWidth: 2,
      pointRadius: 0,
      fill: false,
      tension: 0.4,
      order: 0
    },
    ...shadedSets.map(pts => ({
      data: pts,
      borderColor: 'rgba(26,58,107,0.45)',
      backgroundColor: 'rgba(26,58,107,0.18)',
      borderWidth: 1,
      pointRadius: 0,
      fill: 'origin',
      tension: 0.4,
      order: 1
    }))
  ];

  myChart = new Chart(ctx, {
    type: 'scatter',
    data: { datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 350 },
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      scales: {
        x: {
          type: 'linear', min: -4, max: 4,
          ticks: { font: { family: "'IBM Plex Mono', monospace", size: 11 }, stepSize: 1 },
          grid: { color: 'rgba(0,0,0,0.06)' }
        },
        y: {
          min: 0, max: 0.44,
          ticks: { font: { family: "'IBM Plex Mono', monospace", size: 11 } },
          grid: { color: 'rgba(0,0,0,0.06)' }
        }
      },
      showLine: true
    }
  });
}

// ── Calculate ─────────────────────────────────────────────────────────────────
function renderResults(shadedSets, note, grupos) {
  buildChart(shadedSets);
  document.getElementById('chartNote').textContent = note;
  document.getElementById('statsGrid').innerHTML = `<div class="res-split">${grupos.join('')}</div>`;
  document.getElementById('results').style.display = 'block';
}

function calcular() {
  document.getElementById('errorBox').style.display = 'none';

  const cdf  = x => normalCDF(x);
  const fmt6 = n => parseFloat(n.toFixed(6)).toString();
  const fmt4 = n => n.toFixed(4);
  const fmtZ = n => !isFinite(n) ? (n > 0 ? '∞' : '−∞') : parseFloat(n.toFixed(4)).toString();
  const pct  = n => fmt(n * 100, 4) + '%';
  const alto = k => isFinite(k) ? fmt(normalPDF(k), 4) : '0';

  if (inverso) {
    const invType = currentMode === 'between' ? 'center' : currentMode;
    const pval = parseFloat(document.getElementById('pInv').value);
    if (isNaN(pval) || pval <= 0 || pval >= 1) {
      mostrarError('Ingresa una probabilidad entre 0 y 1 (sin incluir extremos).'); return;
    }
    let k, shadedSets, simbolo, verif;
    if (invType === 'left') {
      k = normalQuantile(pval);
      shadedSets = [genCurve(-4, chartClamp(k), 0.02)];
      simbolo = 'P(Z ≤ k)'; verif = cdf(k);
    } else if (invType === 'right') {
      k = normalQuantile(1 - pval);
      shadedSets = [genCurve(chartClamp(k), 4, 0.02)];
      simbolo = 'P(Z ≥ k)'; verif = 1 - cdf(k);
    } else if (invType === 'tails') {
      // p se reparte en las dos colas: p/2 en cada una
      k = normalQuantile(1 - pval / 2);
      shadedSets = [genCurve(-4, chartClamp(-k), 0.02), genCurve(chartClamp(k), 4, 0.02)];
      simbolo = 'P(|Z| ≥ k)'; verif = 2 * (1 - cdf(k));
    } else {
      k = normalQuantile((1 + pval) / 2);
      shadedSets = [genCurve(chartClamp(-k), chartClamp(k), 0.02)];
      simbolo = 'P(−k ≤ Z ≤ k)'; verif = cdf(k) - cdf(-k);
    }
    const pm = invType === 'center' || invType === 'tails' ? '±' : '';
    const note = `Área sombreada: ${simbolo.replace(/k/g, fmtZ(k))} = ${fmt4(pval)}`;
    renderResults(shadedSets, note, [
      grupoRes('Parámetros', [
        celda('p', 'probabilidad dada', pval),
        celda('1 − p', 'área fuera', fmt6(1 - pval)),
      ]),
      grupoRes('Resultado', [
        celda(pm + 'k', 'valor crítico', pm + fmtZ(k), true),
        celda(simbolo, 'verificación', fmt6(verif)),
      ]),
      grupoRes('En porcentaje', [
        celda('p', 'dentro del área', pct(pval)),
        celda('1 − p', 'fuera del área', pct(1 - pval)),
      ]),
    ]);
    return;
  }

  const z1val = parseZ(document.getElementById('z1').value);
  let z2val;
  if (isNaN(z1val)) { mostrarError('Ingresa un valor de k válido.'); return; }
  if (currentMode === 'between') {
    z2val = parseZ(document.getElementById('z2').value);
    if (isNaN(z2val)) { mostrarError('Ingresa un valor de k₂ válido.'); return; }
    if (z1val >= z2val) { mostrarError('k₁ debe ser menor que k₂.'); return; }
  }
  if (currentMode === 'tails' && z1val <= 0) { mostrarError('Ingresa un valor k positivo para cola doble.'); return; }

  let prob, shadedSets, simbolo, texto, entrada;
  if (currentMode === 'left') {
    prob = cdf(z1val);
    shadedSets = [genCurve(-4, chartClamp(z1val), 0.02)];
    simbolo = 'P(Z ≤ k)'; texto = `P(Z ≤ ${fmtZ(z1val)})`;
    entrada = [celda('k', 'valor dado', fmtZ(z1val)), celda('f(k)', 'altura de la curva', alto(z1val))];
  } else if (currentMode === 'right') {
    prob = 1 - cdf(z1val);
    shadedSets = [genCurve(chartClamp(z1val), 4, 0.02)];
    simbolo = 'P(Z ≥ k)'; texto = `P(Z ≥ ${fmtZ(z1val)})`;
    entrada = [celda('k', 'valor dado', fmtZ(z1val)), celda('f(k)', 'altura de la curva', alto(z1val))];
  } else if (currentMode === 'between') {
    prob = cdf(z2val) - cdf(z1val);
    shadedSets = [genCurve(chartClamp(z1val), chartClamp(z2val), 0.02)];
    simbolo = 'P(k₁ ≤ Z ≤ k₂)'; texto = `P(${fmtZ(z1val)} ≤ Z ≤ ${fmtZ(z2val)})`;
    entrada = [celda('k₁', 'límite inferior', fmtZ(z1val)), celda('k₂', 'límite superior', fmtZ(z2val))];
  } else {
    prob = 2 * (1 - cdf(z1val));
    shadedSets = [genCurve(-4, chartClamp(-z1val), 0.02), genCurve(chartClamp(z1val), 4, 0.02)];
    simbolo = 'P(|Z| ≥ k)'; texto = `P(|Z| ≥ ${fmtZ(z1val)})`;
    entrada = [celda('±k', 'valor dado', '±' + fmtZ(z1val)), celda('f(k)', 'altura de la curva', alto(z1val))];
  }

  renderResults(shadedSets, `Área sombreada: ${texto} = ${fmt4(prob)}`, [
    grupoRes('Parámetros', entrada),
    grupoRes('Resultado', [
      celda(simbolo, 'probabilidad', fmt6(prob), true),
      celda('1 − P', 'complemento', fmt6(1 - prob)),
    ]),
    grupoRes('En porcentaje', [
      celda('P', 'dentro del área', pct(prob)),
      celda('1 − P', 'fuera del área', pct(1 - prob)),
    ]),
  ]);
}

function mostrarError(msg) {
  const box = document.getElementById('errorBox');
  box.textContent   = '✕  ' + msg;
  box.style.display = 'block';
}

document.addEventListener('DOMContentLoaded', () => {
  ['z1','z2','pInv'].forEach(id => {
    document.getElementById(id).addEventListener('keydown', e => {
      if (e.key === 'Enter') calcular();
    });
  });
  ['z1','z2'].forEach(id => {
    document.getElementById(id).addEventListener('input', () => {
      document.querySelectorAll(`[id^="inf-${id}-"]`).forEach(b => b.classList.remove('active'));
    });
  });
});
</script>
