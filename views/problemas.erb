<script>
function normalPDF(z) {
  return Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI);
}

function normalCDF(z) {
  const a1=0.254829592, a2=-0.284496736, a3=1.421413741,
        a4=-1.453152027, a5=1.061405429, p=0.3275911;
  const sign = z < 0 ? -1 : 1;
  const x = Math.abs(z) / Math.sqrt(2);
  const t = 1 / (1 + p * x);
  const y = 1 - (((((a5*t + a4)*t + a3)*t + a2)*t + a1)*t * Math.exp(-x*x));
  return 0.5 * (1 + sign * y);
}

function genCurve(from, to, step) {
  const pts = [];
  for (let z = from; z <= to + step / 2; z += step) {
    pts.push({ x: +z.toFixed(3), y: normalPDF(z) });
  }
  return pts;
}

const probCharts = {};

function buildProblemChart(canvasId, shadedSets, note) {
  if (probCharts[canvasId]) {
    probCharts[canvasId].destroy();
    delete probCharts[canvasId];
  }
  const ctx = document.getElementById(canvasId).getContext('2d');
  const fullCurve = genCurve(-4, 4, 0.04);
  const datasets = [
    {
      data: fullCurve,
      borderColor: '#1a3a6b',
      borderWidth: 2,
      pointRadius: 0,
      fill: false,
      tension: 0.4,
      order: 0
    },
    ...shadedSets.map(pts => ({
      data: pts,
      borderColor: 'rgba(26,58,107,0.45)',
      backgroundColor: 'rgba(26,58,107,0.18)',
      borderWidth: 1,
      pointRadius: 0,
      fill: 'origin',
      tension: 0.4,
      order: 1
    }))
  ];
  probCharts[canvasId] = new Chart(ctx, {
    type: 'scatter',
    data: { datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 350 },
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      scales: {
        x: {
          type: 'linear', min: -4, max: 4,
          ticks: { font: { family: "'IBM Plex Mono', monospace", size: 10 }, stepSize: 1 },
          grid: { color: 'rgba(0,0,0,0.06)' }
        },
        y: {
          min: 0, max: 0.44,
          ticks: { font: { family: "'IBM Plex Mono', monospace", size: 10 } },
          grid: { color: 'rgba(0,0,0,0.06)' }
        }
      },
      showLine: true
    }
  });
  const noteEl = document.getElementById(canvasId + '-note');
  if (noteEl) noteEl.textContent = note;
}

function buildRegressionChart(canvasId, xs, ys, b0, b1, note) {
  if (probCharts[canvasId]) {
    probCharts[canvasId].destroy();
    delete probCharts[canvasId];
  }
  const xMin = Math.min(...xs), xMax = Math.max(...xs);
  const ctx = document.getElementById(canvasId).getContext('2d');
  probCharts[canvasId] = new Chart(ctx, {
    type: 'scatter',
    data: {
      datasets: [
        {
          data: xs.map((x, i) => ({ x, y: ys[i] })),
          backgroundColor: '#1a3a6b',
          pointRadius: 4,
          showLine: false
        },
        {
          data: [{ x: xMin, y: b0 + b1 * xMin }, { x: xMax, y: b0 + b1 * xMax }],
          borderColor: 'rgba(26,58,107,0.55)',
          borderWidth: 2,
          pointRadius: 0,
          showLine: true,
          fill: false
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 350 },
      plugins: { legend: { display: false } },
      scales: {
        x: {
          type: 'linear',
          ticks: { font: { family: "'IBM Plex Mono', monospace", size: 10 } },
          grid: { color: 'rgba(0,0,0,0.06)' }
        },
        y: {
          ticks: { font: { family: "'IBM Plex Mono', monospace", size: 10 } },
          grid: { color: 'rgba(0,0,0,0.06)' }
        }
      }
    }
  });
  const noteEl = document.getElementById(canvasId + '-note');
  if (noteEl) noteEl.textContent = note;
}

const PROBLEM_CHARTS = {
  'p17': () => buildRegressionChart('chart-p17', [1, 2, 3, 4, 5], [52, 58, 65, 70, 75], 46.6, 5.8, 'Datos y recta ŷ = 46.6 + 5.8x'),
  'p18': () => buildRegressionChart('chart-p18', [10, 15, 20, 25, 30, 35], [110, 125, 140, 148, 165, 178], 84.162, 2.6743, 'Datos y recta ŷ = 84.16 + 2.674x'),
  'p1': () => buildProblemChart('chart-p1', [genCurve(-4, 1.50, 0.02)],     'Área sombreada: P(Z ≤ 1.50) ≈ 0.9332'),
  'p2': () => buildProblemChart('chart-p2', [genCurve(1.20, 4, 0.02)],      'Área sombreada: P(Z ≥ 1.20) ≈ 0.1151'),
  'p3': () => buildProblemChart('chart-p3', [genCurve(-1.00, 2.00, 0.02)],  'Área sombreada: P(−1 ≤ Z ≤ 2) ≈ 0.8186'),
  'p4': () => buildProblemChart('chart-p4', [genCurve(-4, -1.50, 0.02)],    'Área sombreada: P(Z ≤ −1.50) ≈ 0.0668'),
  'p5': () => buildProblemChart('chart-p5', [genCurve(-1.75, 1.75, 0.02)],  'Área sombreada: P(−1.75 ≤ Z ≤ 1.75) ≈ 0.9198'),
};

const renderedCharts = new Set();

function toggle(id) {
  const card = document.getElementById(id);
  card.classList.toggle('open');
  if (card.classList.contains('open') && PROBLEM_CHARTS[id] && !renderedCharts.has(id)) {
    renderedCharts.add(id);
    setTimeout(() => PROBLEM_CHARTS[id](), 50);
  }
}
