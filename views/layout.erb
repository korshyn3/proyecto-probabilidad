<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Aproxima2</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.js"></script>
  <link rel="stylesheet" href="/styles.css?v=11">
  <link rel="stylesheet" href="/homeStyle.css">
  <script src="/app.js?v=2"></script>
</head>
<body>

<%
  # Menú: [texto, ruta] o [texto, [[texto, ruta], ...]] para un submenú
  menu = [
    ['Inicio', '/'],
    ['Descriptiva', [['Varianza', '/varianza'], ['Valor esperado', '/valor_esperado']]],
    ['Distribuciones', [['Normal', '/normal'], ['t-Student', '/tstudent']]],
    ['Inferencia', [['Tamaño de muestra', '/tamano_muestra'], ['ANOVA de un factor', '/anova']]],
    ['Regresión', [['Regresión simple', '/regresion'], ['Regresión múltiple', '/regresion_multiple']]],
    ['Problemas', '/problemas'],
    ['Acerca de', '/acerca'],
  ]
%>
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-brand">
      <div><img src="/images/logo.png" alt="Aproxima2Logo" class="brand-icon"></div>
      <span class="brand-text">Aproxima2</span>
    </a>
    <ul class="nav-links">
      <% menu.each do |texto, destino| %>
        <% if destino.is_a?(Array) %>
          <% activo = destino.any? { |_, ruta| request.path == ruta } %>
          <li class="has-sub">
            <button type="button" class="nav-parent <%= 'active' if activo %>"><%= texto %></button>
            <ul class="submenu">
              <% destino.each do |sub, ruta| %>
                <li><a href="<%= ruta %>" class="<%= 'active' if request.path == ruta %>"><%= sub %></a></li>
              <% end %>
            </ul>
          </li>
        <% else %>
          <li><a href="<%= destino %>" class="<%= 'active' if request.path == destino %>"><%= texto %></a></li>
        <% end %>
      <% end %>
    </ul>
  </div>
</nav>

<%= yield %>

<script>
  document.querySelectorAll('textarea').forEach(ajustarAltura);

  // Fórmulas en notación matemática (si KaTeX no carga, queda el texto lineal)
  document.addEventListener('DOMContentLoaded', () => {
    if (!window.katex) return;
    document.querySelectorAll('[data-tex]').forEach(el => {
      katex.render('\\displaystyle ' + el.dataset.tex, el, { throwOnError: false });
    });
  });
</script>

</body>
</html>
